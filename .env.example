# Mail Agent Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Google Gemini API Key
MAIL_AGENT_GEMINI_API_KEY=your-google-gemini-api-key-here

# Mock SMTP Server Connection (defaults work for local development)
MAIL_AGENT_MOCK_SMTP_API_URL=http://localhost:8025
MAIL_AGENT_MOCK_SMTP_HOST=localhost
MAIL_AGENT_MOCK_SMTP_PORT=1025

# Agent Identity
MAIL_AGENT_AGENT_EMAIL=info-agent@gmail.com

# Webhook Server
MAIL_AGENT_WEBHOOK_HOST=localhost
MAIL_AGENT_WEBHOOK_PORT=9000
MAIL_AGENT_WEBHOOK_PATH=/webhook/email-received

# LLM Configuration
MAIL_AGENT_GEMINI_MODEL=gemini-2.0-flash-exp
MAIL_AGENT_GEMINI_TEMPERATURE=0.7
MAIL_AGENT_GEMINI_MAX_TOKENS=2048
MAIL_AGENT_GEMINI_TIMEOUT=60.0

# Agent Behavior
MAIL_AGENT_MAX_ATTEMPTS=5
# MAIL_AGENT_WEBHOOK_WAIT_TIMEOUT=  # Optional timeout in seconds (unset = wait indefinitely)

# State Persistence
MAIL_AGENT_SQLITE_DB_PATH=./mail_agent_state.db

# Logging
MAIL_AGENT_LOG_LEVEL=INFO
